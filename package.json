{
  "name": "sprite-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "proxy": "node proxy/server.mjs",
    "check": "tsc -b --pretty",
    "test:exports": "tsx --test src/spriteSheet.test.ts src/schemas.test.ts src/animationSheet.test.ts src/lib/helpers.test.ts src/lib/frameTouchup.test.ts src/lib/imageReferences.test.ts src/lib/imageResponse.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postbuild": "npm run format",
    "tauri": "tauri"
  },
  "dependencies": {
    "@ark-ui/react": "^5.39.3",
    "@tauri-apps/api": "^2.12.2",
    "@tauri-apps/cli": "^2.12.1",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-fs": "^2.6.0",
    "@tauri-apps/plugin-sql": "^2.5.0",
    "fflate": "^0.8.3",
    "gifenc": "^1.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "upng-js": "^2.1.0",
    "wasm-webp": "^0.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/upng-js": "^2.1.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.29",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "~5.7.2",
    "vite": "^6.0.7"
  }
}
